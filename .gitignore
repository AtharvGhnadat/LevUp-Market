node_modules/
dist/
build/
.cache/
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo

# Environment variables — never commit real credentials
# .env.local, .env.production, etc. are excluded
# .env.example is intentionally NOT excluded (it is a safe template)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs — excluded from version control
# See docs/08-operations/LOGGING_STANDARD.md
logs/
*.log
*-debug.log*

# Test artifacts
test-results/
playwright-report/
playwright/.cache/
coverage/

# Temporary files
.tmp-*
.claude-replay.*

# Figma Make design context (generated, not source)
/.figma/design-context/

# Platform-managed agentplat state
# In the client-initiated single-repo workspace layout (make's `Path: "."` spec)
# the repo root IS the workspace root, so these land inside this repo.
/.plugins/
/.opencode-skills/
