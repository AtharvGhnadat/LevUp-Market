# Environment Variables — LevUp Projects

# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real credentials.

# =============================================================================
# APPLICATION
# =============================================================================

# Node environment: development | test | production
NODE_ENV=development

# Application URL (used for absolute URL generation, OAuth redirects, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application version (populated automatically by CI from package.json)
NEXT_PUBLIC_APP_VERSION=0.0.0

# =============================================================================
# SUPABASE
# =============================================================================

# Browser configuration for the Vite app. Use a publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy browser key. A service role key must never use a VITE_ prefix.
VITE_SUPABASE_ANON_KEY=

# Next.js and server configuration references
# Your Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous / public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key — SERVER-SIDE ONLY. Never expose to the browser.
# Used for admin operations that bypass Row-Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =============================================================================
# CASHFREE PAYMENTS
# =============================================================================

# Cashfree environment: sandbox | production
CASHFREE_ENV=sandbox

# Cashfree App ID — identifies your merchant account
# Safe to reference server-side; do NOT expose to the browser directly.
CASHFREE_APP_ID=your-cashfree-app-id

# Cashfree Client Secret — SERVER-SIDE ONLY. Never expose to the browser.
CASHFREE_CLIENT_SECRET=your-cashfree-client-secret

# Cashfree webhook secret — used to verify webhook signatures
# SERVER-SIDE ONLY. Never expose to the browser.
CASHFREE_WEBHOOK_SECRET=your-cashfree-webhook-secret

# =============================================================================
# ADMIN
# =============================================================================

# Comma-separated list of Supabase user IDs allowed to access the admin portal.
# This is an allowlist; actual authorization is enforced server-side.
ADMIN_USER_IDS=

# =============================================================================
# LOGGING AND OBSERVABILITY
# =============================================================================

# Minimum log level: debug | info | warn | error
LOG_LEVEL=info

# Sentry DSN — set when Sentry is configured
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# =============================================================================
# DEPLOYMENT (Vercel / CI)
# =============================================================================

# Set automatically by Vercel; do not set manually in .env.local
# VERCEL_ENV=preview
# VERCEL_URL=your-deployment-url.vercel.app
# VERCEL_GIT_COMMIT_SHA=abc123
